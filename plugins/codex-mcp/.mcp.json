{
  "mcpServers": {
    "codex-mcp": {
      "command": "bunx",
      "args": ["@kvokka/codex-mcp@3.1.0"],
      "env": {
        "CODEX_MCP_DEFAULT_MODEL": "gpt-5.6-luna",
        "CODEX_MCP_DEFAULT_EFFORT": "high",
        "CODEX_MCP_DEFAULT_APPROVAL_TIMEOUT_MS": "900000",
        "CODEX_MCP_DEFAULT_APPROVAL_POLICY": "never",
        "CODEX_MCP_DEFAULT_SANDBOX": "danger-full-access"
      }
    }
  }
}
